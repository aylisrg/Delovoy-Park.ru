# Опциональные переменные окружения (инлайнятся в статический билд).
# Скопируйте в .env.local для локальной разработки или задайте в CI
# (GitHub: Settings → Secrets and variables → Actions → Variables).

# ID счётчика Яндекс.Метрики (только число, без кавычек). Если не задан — счётчик не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# ID форм Formspree (часть после /f/). Если не заданы — формы показывают
# ошибку с прямыми контактами вместо ложного «отправлено».
NEXT_PUBLIC_FORMSPREE_WAITLIST_ID=
NEXT_PUBLIC_FORMSPREE_CONTACT_ID=
